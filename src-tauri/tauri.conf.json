{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyflow-desktop",
  "version": "0.1.0",
  "identifier": "KeyFlow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "width": 800,
        "height": 600,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#e5e7eb",
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "editor",
        "width": 800,
        "height": 600,
        "minWidth": 760,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#e5e7eb",
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "tool",
        "width": 800,
        "height": 600,
        "visible": false,
        "backgroundColor": "#00000000",
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:keyflow.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
