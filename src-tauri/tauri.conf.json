{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silkio Space",
  "mainBinaryName": "Silkio Space",
  "version": "0.1.0",
  "identifier": "cn.silkio.space",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silkio Space",
        "width": 1024,
        "height": 640,
        "center": true,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#e5e7eb",
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "editor",
        "title": "Silkio Space - 编辑",
        "width": 1024,
        "height": 640,
        "center": true,
        "minWidth": 760,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#e5e7eb",
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "tool",
        "title": "Silkio Space - 创建",
        "width": 288,
        "height": 248,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:silkio-space.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
